# =============================================================================
# Storytime API — environment template
# Copy to `.env` and fill in real values. Never commit the real `.env`.
# =============================================================================

# --- Core / server ----------------------------------------------------------
NODE_ENV=development                 # development | staging | production
PORT=3500
BACKEND_BASE_URL=http://localhost:3500
WEB_APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000    # comma-separated list of allowed origins

# --- Database & cache -------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/storytime_db?connection_limit=20&pool_timeout=30"
# Redis is used for BullMQ queues, caching, and guest sessions.
# The password in the URL MUST match the Redis server's `requirepass`
# (omit `:password@` entirely if the server has no password).
REDIS_URL=redis://:password@localhost:6379

# --- Auth / secrets ---------------------------------------------------------
JWT_SECRET=change-me-jwt-secret
SECRET=change-me-app-secret
ADMIN_SECRET=change-me-admin-secret

# --- Google OAuth -----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3500/api/v1/auth/google/callback

# --- Apple Sign-in / In-App Purchase ---------------------------------------
APPLE_CLIENT_ID=
APPLE_SERVICE_ID=
APPLE_IAP_BUNDLE_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_ROOT_CERTS=

# --- AI / voice providers ---------------------------------------------------
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
ELEVEN_LABS_KEY=
GOOGLE_TTS_API_KEY=
HF_TOKEN=

# --- Email / SMTP -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_ENCRYPTION=tls
BREVO_API_URL=
BREVO_API_KEY=
DEFAULT_SENDER_EMAIL=noreply@example.com
DEFAULT_SENDER_NAME=Storytime
SUPPORT_EMAIL=support@example.com

# --- Media (Cloudinary) -----------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# Observability (OpenTelemetry + Grafana Cloud + Sentry + UptimeRobot)
# -----------------------------------------------------------------------------
# ALL of the variables below are OPTIONAL. With none set, the app behaves
# exactly as before: traces/logs are not exported, metrics are served on the
# local Prometheus endpoint (:9464), and Sentry is disabled. Set them to
# activate each signal. See GRAFANA_SETUP.md and docs/OBSERVABILITY.md.
# =============================================================================

# --- OpenTelemetry: general -------------------------------------------------
OTEL_SERVICE_NAME=storytime-api      # resource service.name (default: storytime-api)

# OTLP endpoints. Point these at your collector or the Grafana Cloud OTLP
# gateway. Defaults target a local collector (http://localhost:4318/...).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_LOGS_ENDPOINT=http://localhost:4318/v1/logs
OTEL_EXPORTER_METRICS_ENDPOINT=http://localhost:4318/v1/metrics

# Extra OTLP headers as comma-separated key=value pairs (applied to traces,
# logs, and metrics). Use this OR the GRAFANA_CLOUD_* pair below — not both.
# Example: OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceID:token)>
OTEL_EXPORTER_OTLP_HEADERS=

# --- Metrics exporter mode --------------------------------------------------
# prometheus (default) = local pull endpoint on :9464/metrics
# otlp                  = push metrics to OTEL_EXPORTER_METRICS_ENDPOINT
OTEL_METRICS_EXPORTER=prometheus
PROMETHEUS_PORT=9464                 # only used when OTEL_METRICS_EXPORTER=prometheus
OTEL_METRIC_EXPORT_INTERVAL=60000    # ms; only used when OTEL_METRICS_EXPORTER=otlp

# --- Grafana Cloud (managed OTLP push) --------------------------------------
# Convenience: when both are set, an `Authorization: Basic base64(id:token)`
# header is built automatically and applied to all three OTLP exporters — so
# you don't need OTEL_EXPORTER_OTLP_HEADERS. Get these from your Grafana Cloud
# stack → "OpenTelemetry" / access policy token.
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
# GRAFANA_CLOUD_API_KEY=            # legacy alias for GRAFANA_CLOUD_API_TOKEN

# --- Sentry (error tracking, OTel-trace-linked) -----------------------------
# When SENTRY_DSN is set, errors are reported to Sentry and linked to their
# OTel trace. Unset = Sentry fully disabled (no-op).
SENTRY_DSN=
SENTRY_RELEASE=                      # defaults to package version
SENTRY_TRACES_SAMPLE_RATE=0          # 0.0–1.0 (0 = no perf tracing)

# --- UptimeRobot ------------------------------------------------------------
# No env/code needed. Create an external HTTP(s) monitor pointing at the
# public health endpoint: GET https://<your-host>/api/v1/health/ready
# Route its alerts to the same channel as Sentry. See docs/OBSERVABILITY.md.
