          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_duration_milliseconds_bucket{job=~\"$job\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        }
