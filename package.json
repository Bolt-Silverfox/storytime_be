  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:pm2:dev": "bash scripts/pm2-safe-restart.sh storytime-api-development",
    "start:pm2:staging": "bash scripts/pm2-safe-restart.sh storytime-api-staging",
    "start:pm2:prod": "bash scripts/pm2-safe-restart.sh storytime-api-production",
    "start:pm2:blue": "bash scripts/pm2-safe-restart.sh storytime-api-blue",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "npx prisma generate",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:reset": "npx prisma migrate reset",
    "db:seed": "npx ts-node prisma/seeds/index.ts",
    "deploy:dev": "pnpm db:migrate:deploy && pnpm db:generate && pnpm start:pm2:dev",
    "deploy:staging": "pnpm db:migrate:deploy && pnpm db:generate && pnpm start:pm2:staging",
    "deploy:prod": "pnpm db:generate && pnpm start:pm2:prod",
    "deploy:blue": "pnpm db:migrate:deploy && pnpm db:generate && pnpm start:pm2:blue"
  },
