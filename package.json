{
  "name": "storytime_be",
  "version": "1.1.0",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "description": "Storytime API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:pm2:dev": "npx pm2 startOrReload ecosystem.config.js --only storytime-api-development --update-env",
    "start:pm2:staging": "npx pm2 startOrReload ecosystem.config.js --only storytime-api-staging --update-env",
    "start:pm2:prod": "npx pm2 startOrReload ecosystem.config.js --only storytime-api-production --update-env",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "npx prisma generate",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:reset": "npx prisma migrate reset",
    "db:seed": "npx ts-node prisma/seeds/index.ts",
    "deploy:dev": "pnpm db:migrate:deploy && pnpm db:generate && pnpm start:pm2:dev",
    "deploy:staging": "pnpm db:migrate:deploy && pnpm db:generate && pnpm start:pm2:staging",
    "deploy:prod": "pnpm db:generate && pnpm start:pm2:prod"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.0",
    "@deepgram/sdk": "^4.11.3",
    "@google/genai": "^1.52.0",
    "@google/generative-ai": "^0.24.1",
    "@hng-sdk/email": "^0.0.0",
    "@keyv/redis": "^5.1.6",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.19.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-email/tailwind": "^2.0.7",
    "@types/nodemailer": "^7.0.12",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "apple-signin-auth": "^2.1.0",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "buffer-to-stream": "^1.0.0",
    "bullmq": "^5.81.3",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "ejs": "^3.1.10",
    "elevenlabs": "^1.59.0",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "keyv": "^5.6.0",
    "multer": "^2.2.0",
    "nodemailer": "^7.0.13",
    "passport": "^0.7.0",
    "passport-custom": "^1.2.1",
    "passport-google-oauth20": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.1",
    "zod": "^3.25.76"
